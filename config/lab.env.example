# Optional overrides. The scripts already default to the lab described in README.md.
# Copy this file to config/lab.env and edit if required, then:
#   source config/lab.env

# Target compatibility story
export TARGET_OCP_VERSION="4.20"

# Boot sources
export RHEL9_DATASOURCE="rhel9"
export RHEL9_DATASOURCE_NS="openshift-virtualization-os-images"
export WINDOWS_DATASOURCE="win2022-demo-v2"
export WINDOWS_DATASOURCE_NS="openshift-virtualization-os-images"

# Windows uses a generated lab-only Administrator password plus AutoLogon, so
# no password entry is required during the demo. The generated password is stored
# in .demo-state/credentials.env (mode 0600).
# export DEMO_ADMIN_PASSWORD='Choose-A-Lab-Only-Password'

# Windows VM resources
export WINDOWS_MEMORY="4Gi"
export WINDOWS_CORES="2"

# RHEL 9 VM resources
export RHEL_MEMORY="2Gi"
export RHEL_CORES="2"

# Windows image-upload defaults for this lab
export WINDOWS_STORAGE_CLASS="ocs-external-storagecluster-ceph-rbd"
export WINDOWS_IMAGE_SIZE="70Gi"
